# Port server Fastify + Socket.IO
PORT=4000

# Origin frontend yang diizinkan (CORS)
CLIENT_URL=http://localhost:5173

# Detik tanpa aktivitas sebelum pemain dianggap tidak aktif dan dikeluarkan dari server
PLAYER_INACTIVITY_SECONDS=180

# Detik sebelum avatar pemain yang putus koneksi benar-benar dihapus (grace period)
DISCONNECT_GRACE_SECONDS=15

# Detik sebelum workspace otomatis yang kosong dihapus
WORKSPACE_CLEANUP_GRACE_SECONDS=120

# Kapasitas server: AUTO_JOIN_CAP untuk quick join, HARD_CAP untuk join dengan kode
SERVER_AUTO_JOIN_CAP=10
SERVER_HARD_CAP=15

# Kode wilayah administrasi tingkat IV (kelurahan/desa) untuk data cuaca BMKG
# Format: XX.XX.XX.XXXX, lihat Kepmendagri 100.1.1-6117 Tahun 2022
BMKG_ADM4=33.13.12.2007

# Postgres lewat transaction-mode pooler (dipakai aplikasi)
DATABASE_URL="postgresql://postgres.<project-ref>:<db-password>@<pooler-host>:6543/postgres?pgbouncer=true"

# Postgres lewat session-mode pooler (dipakai untuk migrasi Prisma)
DIRECT_URL="postgresql://postgres.<project-ref>:<db-password>@<pooler-host>:5432/postgres"

# Supabase
SUPABASE_URL="https://<project-ref>.supabase.co"
SUPABASE_SECRET_KEY="<supabase-secret-key>"